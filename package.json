{
  "name": "openmeitu",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source alternative to Meitu Xiuxiu, Facetune, and BeautyPlus",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "predev": "npm run setup:assets",
    "dev": "vite",
    "prebuild": "npm run setup:assets",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures:faces": "UPDATE_FACE_FIXTURES=1 playwright test tests/e2e/face-detect.spec.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
